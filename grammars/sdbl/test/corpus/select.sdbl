====================
Select rejects index clause after where
====================

ВЫБРАТЬ
    Номенклатура.Код
ИЗ
    Справочник.Номенклатура КАК Номенклатура
ГДЕ
    Номенклатура.Код > 0
ИНДЕКСИРОВАТЬ ПО
    Номенклатура.Код

---

(query
  (select_section
    (SELECT_KEYWORD)
    (field_list
      (field
        value: (query_expression
          (dotted_identifier
            (identifier)
            (identifier)))))
    (from_clause
      (FROM_KEYWORD)
      (source_list
        (table_source
          name: (dotted_identifier
            (identifier)
            (identifier))
          (source_alias
            (AS_KEYWORD)
            (identifier)))))
    (where_clause
      (WHERE_KEYWORD)
      (ERROR
        (query_expression
          (binary_expression
            left: (query_expression
              (dotted_identifier
                (identifier)
                (identifier)))
            operator: (comparison_operator)
            right: (query_expression
              (number))))
        (identifier)
        (BY_KEYWORD))
      (query_expression
        (dotted_identifier
          (identifier)
          (identifier))))))
