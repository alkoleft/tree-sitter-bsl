====================
Select wildcard
====================

ВЫБРАТЬ
    *

---

(query
  (select_section
    (SELECT_KEYWORD)
    (field_list
      (wildcard))))

====================
Select fields from source
====================

ВЫБРАТЬ
    Справочник.Номенклатура.Ссылка
ИЗ
    Справочник.Номенклатура КАК Номенклатура

---

(query
  (select_section
    (SELECT_KEYWORD)
    (field_list
      (field
        value: (query_expression
          (dotted_identifier
            (identifier)
            (identifier)
            (identifier)))))
    (from_clause
      (FROM_KEYWORD)
      (source_list
        (table_source
          name: (dotted_identifier
            (identifier)
            (identifier))
          (source_alias
            (AS_KEYWORD)
            (identifier)))))))

====================
Select options aliases and where comparison
====================

ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 10
    Номенклатура.Ссылка КАК Ссылка,
    Номенклатура.Наименование
ИЗ
    Справочник.Номенклатура КАК Номенклатура
ГДЕ
    Номенклатура.ПометкаУдаления = ЛОЖЬ

---

(query
  (select_section
    (SELECT_KEYWORD)
    (DISTINCT_KEYWORD)
    (top_clause
      (TOP_KEYWORD)
      count: (number))
    (field_list
      (field
        value: (query_expression
          (dotted_identifier
            (identifier)
            (identifier)))
        (field_alias
          (AS_KEYWORD)
          (identifier)))
      (field
        value: (query_expression
          (dotted_identifier
            (identifier)
            (identifier)))))
    (from_clause
      (FROM_KEYWORD)
      (source_list
        (table_source
          name: (dotted_identifier
            (identifier)
            (identifier))
          (source_alias
            (AS_KEYWORD)
            (identifier)))))
    (where_clause
      (WHERE_KEYWORD)
      (query_expression
        (binary_expression
          left: (query_expression
            (dotted_identifier
              (identifier)
              (identifier)))
          operator: (comparison_operator)
          right: (query_expression
            (boolean
              (FALSE_KEYWORD))))))))

====================
Allowed fields parameters and boolean conditions
====================

ВЫБРАТЬ РАЗРЕШЕННЫЕ
    Номенклатура.Ссылка Ссылка,
    &Период КАК Период,
    "Строка" КАК Представление,
    NULL КАК ПустоеЗначение,
    НЕОПРЕДЕЛЕНО КАК НеопределенноеЗначение,
    '20240101000000' КАК Дата
ИЗ
    Справочник.Номенклатура Номенклатура
ГДЕ
    Номенклатура.ЭтоГруппа = ИСТИНА И НЕ Номенклатура.ПометкаУдаления

---

(query
  (select_section
    (SELECT_KEYWORD)
    (ALLOWED_KEYWORD)
    (field_list
      (field
        value: (query_expression
          (dotted_identifier
            (identifier)
            (identifier)))
        (field_alias
          (identifier)))
      (field
        value: (query_expression
          (parameter
            (identifier)))
        (field_alias
          (AS_KEYWORD)
          (identifier)))
      (field
        value: (query_expression
          (string
            (string_content)))
        (field_alias
          (AS_KEYWORD)
          (identifier)))
      (field
        value: (query_expression
          (null
            (NULL_KEYWORD)))
        (field_alias
          (AS_KEYWORD)
          (identifier)))
      (field
        value: (query_expression
          (undefined
            (UNDEFINED_KEYWORD)))
        (field_alias
          (AS_KEYWORD)
          (identifier)))
      (field
        value: (query_expression
          (date))
        (field_alias
          (AS_KEYWORD)
          (identifier))))
    (from_clause
      (FROM_KEYWORD)
      (source_list
        (table_source
          name: (dotted_identifier
            (identifier)
            (identifier))
          (source_alias
            (identifier)))))
    (where_clause
      (WHERE_KEYWORD)
      (query_expression
        (binary_expression
          left: (query_expression
            (binary_expression
              left: (query_expression
                (dotted_identifier
                  (identifier)
                  (identifier)))
              operator: (comparison_operator)
              right: (query_expression
                (boolean
                  (TRUE_KEYWORD)))))
          operator: (AND_KEYWORD)
          right: (query_expression
            (unary_expression
              operator: (not_operator
                (NOT_KEYWORD))
              argument: (query_expression
                (dotted_identifier
                  (identifier)
                  (identifier))))))))))

