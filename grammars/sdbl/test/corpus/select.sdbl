(query
  (select_section
    (SELECT_KEYWORD)
    (field_list
      (field
        value: (query_expression
          (dotted_identifier
            (identifier)
            (identifier))))
      (field
        value: (query_expression
          (dotted_identifier
            (identifier)
            (identifier)))))
    (from_clause
      (FROM_KEYWORD)
      (source_list
        (table_source
          name: (dotted_identifier
            (identifier)
            (identifier))
          (source_alias
            (AS_KEYWORD)
            (identifier)))))
    (where_clause
      (WHERE_KEYWORD)
      (query_expression
        (binary_expression
          left: (query_expression
            (dotted_identifier
              (identifier)
              (identifier)))
          operator: (comparison_operator)
          right: (query_expression
            (boolean
              (FALSE_KEYWORD))))))
    (group_by_clause
      (GROUP_KEYWORD)
      (BY_KEYWORD)
      (expression_list
        (query_expression
          (dotted_identifier
            (identifier)
            (identifier)))
        (query_expression
          (dotted_identifier
            (identifier)
            (identifier)))))
    (having_clause
      (HAVING_KEYWORD)
      (query_expression
        (binary_expression
          left: (query_expression
            (dotted_identifier
              (identifier)
              (identifier)))
          operator: (comparison_operator)
          right: (query_expression
            (parameter
              (identifier))))))
    (for_update_clause
      (FOR_KEYWORD)
      (UPDATE_KEYWORD)
      (OF_KEYWORD)
      (table_list
        (identifier)))))

