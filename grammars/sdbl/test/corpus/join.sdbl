              kind: (join_kind
                (RIGHT_KEYWORD))
              (JOIN_KEYWORD)
              source: (dotted_identifier
                (identifier)
                (identifier))
              (source_alias
                (AS_KEYWORD)
                (identifier))
              (ON_KEYWORD)
              condition: (query_expression
