====================
Select joins with source aliases
====================

ВЫБРАТЬ
    Контрагенты.Ссылка КАК Контрагент,
    Банки.Ссылка КАК Банк
ИЗ
    Справочник.Контрагенты КАК Контрагенты
    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
    ПО Контрагенты.Наименование = Банки.Наименование

---

(source_file
  (query
    (select_section
      (SELECT_KEYWORD)
      (field_list
        (field
          value: (query_expression
            (dotted_identifier
              (identifier)
              (identifier)))
          (field_alias
            (AS_KEYWORD)
            (identifier)))
        (field
          value: (query_expression
            (dotted_identifier
              (identifier)
              (identifier)))
          (field_alias
            (AS_KEYWORD)
            (identifier))))
      (from_clause
        (FROM_KEYWORD)
        (source_list
          (table_source
            name: (dotted_identifier
              (identifier)
              (identifier))
            (source_alias
              (AS_KEYWORD)
              (identifier))
            (join_clause
              kind: (join_kind
                (INNER_KEYWORD))
              (JOIN_KEYWORD)
              source: (dotted_identifier
                (identifier)
                (identifier))
              (source_alias
                (AS_KEYWORD)
                (identifier))
              (ON_KEYWORD)
              condition: (query_expression
                (binary_expression
                  left: (query_expression
                    (dotted_identifier
                      (identifier)
                      (identifier)))
                  operator: (comparison_operator)
                  right: (query_expression
                    (dotted_identifier
                      (identifier)
                      (identifier))))))))))))

